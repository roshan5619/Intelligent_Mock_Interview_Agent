# =============================================================================
#  IPHIPI — Agentic AI Mock Interview Platform
#  Copy this file to .env.local and fill in the values.
#  Never commit .env.local — it is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
#  LLM PROVIDERS — at least ONE of Groq / Gemini is required.
#  See README §Get the API keys for step-by-step instructions.
# -----------------------------------------------------------------------------

# Groq Cloud — primary reasoner (Llama 3.3 70B). Free tier.
# Sign up: https://console.groq.com → API Keys → Create
GROQ_API_KEY=

# Google AI Studio — Gemini 2.0 Flash (PDF parsing, multimodal) + embeddings. Free tier.
# Sign up: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# (Optional) Local Ollama fallback — only used if both cloud providers fail
# AND the user has Ollama installed. Leave blank to disable.
# Default: http://localhost:11434
OLLAMA_BASE_URL=

# -----------------------------------------------------------------------------
#  DATABASE — Turso (libSQL). Free tier.
#  Sign up: https://turso.tech, then `turso db create iphipi-prototype`
# -----------------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# For local development without Turso, use a local SQLite file instead:
# Set TURSO_DATABASE_URL=file:./data/iphipi.db (and leave TURSO_AUTH_TOKEN blank)

# -----------------------------------------------------------------------------
#  FILE STORAGE — Vercel Blob. Free tier (1GB).
#  Sign up: https://vercel.com → Storage → Create Blob store
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
#  AUTH — HMAC secret for the no-auth candidate cookie token.
#  Generate one locally:
#   PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Maximum 256 }))
#   bash:       openssl rand -base64 32
# -----------------------------------------------------------------------------
HMAC_SECRET=

# -----------------------------------------------------------------------------
#  Public URL of the deployed app (set automatically by Vercel; override locally)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
